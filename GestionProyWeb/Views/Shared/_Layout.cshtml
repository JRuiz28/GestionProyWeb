<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Mi aplicación ASP.NET</title>
    @Scripts.Render("~/bundles/modernizr")
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body style="background-color: #F4FBFF ;">
    <nav class="navbar  bg-primary-subtle navbar-inverse navbar-fixed-top" data-bs-theme="dark">
        <div class="container">
            <div class="navbar-header">
                @Html.ActionLink("GestiónProy", "Index", "Home", null, new { @class = "navbar-brand" })
            </div>

            <ul class="nav">
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">XXX</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" href="#">XXX</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white">Cerrar sesión</a>
                </li>
            </ul>

        </div>
    </nav>

    <div class="container body-content mt-5">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.9/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
