
@{
    ViewBag.Title = "[Nombre del proyecto]";
}

<div class="text-center">
    <h1><strong>@ViewBag.Title</strong></h1>

    <p class="text-muted">
        Detalle del proyecto
    </p>
</div>

<div class="row mt-3">
    <div class="col-lg-9">
        <div class="row row-3 g-4">
            <h3>Tareas del proyecto</h3>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <img src="../Img/bg-card-task.jpg" class="card-img-top" alt="">
                    <div class="card-body">
                        <h5 class="card-title">Card title</h5>
                        <p class="card-text">
                            This is a longer card with supporting text below
                            as a natural lead-in to additional content.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <img src="../Img/bg-card-task.jpg" class="card-img-top" alt="">
                    <div class="card-body">
                        <h5 class="card-title">Card title</h5>
                        <p class="card-text">
                            This is a longer card with supporting text below
                            as a natural lead-in to additional content.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <img src="../Img/bg-card-task.jpg" class="card-img-top" alt="">
                    <div class="card-body">
                        <h5 class="card-title">Card title</h5>
                        <p class="card-text">
                            This is a longer card with supporting text below
                            as a natural lead-in to additional content.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-3 mt-4 mt-lg-0">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h4 class="card-title">Información del proyecto</h4>
                <p class="card-text text-muted">
                    [Descripción]
                </p>
                <hr />
                <h4>Resumen</h4>
                <p class="mb-2">
                    <strong>Proyecto creado el día:</strong> 12/12/2026
                </p>
                <p class="mb-2">
                    <strong>Fecha de inicio:</strong> 12/12/2026
                </p>
                <p class="mb-2">
                    <strong>Fecha de finalización:</strong> 12/12/2026
                </p>
                <p class="mb-2">
                    <strong>Estado:</strong> Activo
                </p>
                <p class="mb-2">
                    <strong>Asignado a:</strong> Josué Ruiz
                </p>
            </div>

            <div class="card-footer bg-white">
                <button type="button" class="btn btn-outline-warning">
                    Editar
                </button>
                <button type="button" class="btn btn-outline-danger">
                    Eliminar
                </button>
            </div>
        </div>
</div>

